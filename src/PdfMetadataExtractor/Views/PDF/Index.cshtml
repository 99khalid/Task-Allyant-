@{
    ViewData["Title"] = "Upload PDF Files";
}
<h1>Upload PDF Files</h1>
<p class="text-muted">Files are processed in memory and are not stored on the server. Max 20 MB per file.</p>
<form asp-controller="PDF" asp-action="ProcessFiles" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label for="pdfFiles" class="form-label">Select PDF files to upload:</label>
    <input type="file" id="pdfFiles" name="pdfFiles" class="form-control mb-3" multiple accept=".pdf,application/pdf" />
    <button type="submit" class="btn btn-primary">Process Files</button>
</form>
